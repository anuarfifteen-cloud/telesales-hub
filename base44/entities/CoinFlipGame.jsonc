{
  "name": "CoinFlipGame",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID of the user who played"
    },
    "user_email": {
      "type": "string",
      "description": "Email of the user"
    },
    "game_type": {
      "type": "string",
      "enum": [
        "coin_flip",
        "blackjack"
      ],
      "description": "Which game this record belongs to. coin_flip = Double or Nothing coin flip, blackjack = Casino 21. Missing/legacy records are treated as coin_flip.",
      "default": "coin_flip"
    },
    "choice": {
      "type": "string",
      "enum": [
        "heads",
        "tails"
      ],
      "description": "What the user chose (coin flip only). Omitted for blackjack records."
    },
    "outcome": {
      "type": "string",
      "enum": [
        "heads",
        "tails"
      ],
      "description": "Actual flip result (coin flip only). Omitted for blackjack records."
    },
    "wager": {
      "type": "number",
      "description": "Number of tokens wagered"
    },
    "result": {
      "type": "string",
      "enum": [
        "win",
        "loss",
        "push"
      ],
      "description": "Win, loss, or push (tie). push only applies to blackjack."
    },
    "tokens_delta": {
      "type": "number",
      "description": "Token change (positive = won, negative = lost, 0 = push/refund)"
    },
    "detail": {
      "type": "string",
      "description": "Optional human-readable outcome detail, e.g. 'Blackjack!', 'Player bust', 'Dealer bust', 'Push'. Used by blackjack records."
    }
  },
  "required": [
    "user_id",
    "wager",
    "result"
  ]
}