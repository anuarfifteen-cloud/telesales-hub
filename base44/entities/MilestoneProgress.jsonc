{
  "name": "MilestoneProgress",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User ID this progress row belongs to."
    },
    "user_name": {
      "type": "string",
      "description": "Display name of the user."
    },
    "season_number": {
      "type": "number",
      "default": 1,
      "description": "The season this score is for. When the global season advances (Diamond claim or admin reset), this field is rolled over to the new number and the score/claims/streaks reset to zero on the user's next read."
    },
    "score": {
      "type": "number",
      "default": 0,
      "description": "Total winning chip payouts accumulated in the current season. Only wins add to this; losses and pushes do not reduce it."
    },
    "claimed_ranks": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Ranks 1-9 the player has claimed rewards for this season. Each rank reward can be credited only once per season."
    },
    "pending_rank_rewards": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Ranks 1-9 earned but not yet claimed this season. Survives a season reset so unclaimed rewards can still be claimed via the New Season Rewards popup after the reset."
    },
    "reconciled_ranked_wins": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Game-history record IDs of Ranked hands whose winning payouts have already been reconciled into the score. A verified hand whose score write was lost is credited exactly once, and its id is stored here so it can never be credited twice."
    },
    "current_streak": {
      "type": "number",
      "default": 0,
      "description": "The player's live run of consecutive winning Ranked hands this season. A win extends it, a loss or surrender resets it to 0, and a push or tie leaves it unchanged. Casual play never touches it."
    },
    "season_best_streak": {
      "type": "number",
      "default": 0,
      "description": "The longest Ranked win streak the player has reached this season. It only ever moves up, and the player holding the highest value across the season wins 1 \ud83d\udc8e Diamond at season end."
    },
    "season_best_streak_at": {
      "type": "string",
      "description": "ISO timestamp of the exact moment the current season_best_streak was set. Used as the season-end tie-breaker: if several players reach the same highest streak, the earliest record wins the Diamond."
    },
    "briefing_seen_season": {
      "type": "number",
      "default": 0,
      "description": "The season number whose end-of-season briefing (Season Champion + Streak King) this player has already dismissed, so the briefing modal only appears once per season."
    }
  },
  "required": [
    "user_id",
    "season_number",
    "score"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}