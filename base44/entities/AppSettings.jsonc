{
  "name": "AppSettings",
  "type": "object",
  "properties": {
    "vip_pass_price": {
      "type": "number",
      "description": "Cost in tokens to activate the VIP Early Access Pass",
      "default": 1
    },
    "diamond_price": {
      "type": "number",
      "description": "Fixed cost in tokens to purchase 1 diamond",
      "default": 25
    },
    "quiz_enabled": {
      "type": "boolean",
      "description": "Whether the Daily Quiz is enabled for all users",
      "default": true
    },
    "flappy_enabled": {
      "type": "boolean",
      "description": "Whether the Flappy Token game is enabled for all users",
      "default": true
    },
    "flappy_difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard"
      ],
      "description": "Difficulty level for the Flappy Token game",
      "default": "medium"
    },
    "ninja_enabled": {
      "type": "boolean",
      "description": "Whether the Ninja Slice arcade game is visible to players. When false, the Ninja Slice sub-tab button and game panel are completely hidden.",
      "default": true
    },
    "voucher_feed_enabled": {
      "type": "boolean",
      "description": "Whether the live voucher activity feed is shown in the Blind Voucher shop",
      "default": true
    },
    "defending_champ_supertap_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User IDs of the current Super Tap defending champions (publicly readable for leaderboard crown display)"
    },
    "defending_champ_flappy_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User IDs of the current Flappy Token defending champions (publicly readable for leaderboard crown display)"
    },
    "defending_champ_diamond_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User IDs of the current Diamond Smash defending champions (publicly readable for leaderboard crown display)"
    },
    "defending_champ_ninja_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User IDs of the current Ninja Slice defending champions (publicly readable for leaderboard crown display)"
    },
    "hide_diamond_smash_leaderboard": {
      "type": "boolean",
      "description": "When true, the live Diamond Smash leaderboard is hidden from players (Mystery Mode) \u2014 the game stays fully playable and players still see their own personal best",
      "default": false
    },
    "hide_ninja_slice_leaderboard": {
      "type": "boolean",
      "description": "When true, the live Ninja Slice leaderboard is hidden from players (Mystery Mode) \u2014 the game stays fully playable and players still see their own personal best",
      "default": false
    },
    "diamond_store_enabled": {
      "type": "boolean",
      "description": "Master toggle to enable/disable Diamond purchasing",
      "default": false
    },
    "diamond_store_start_time": {
      "type": "string",
      "description": "ISO datetime when the Diamond Store opens for purchasing"
    },
    "diamond_store_end_time": {
      "type": "string",
      "description": "ISO datetime when the Diamond Store closes for purchasing"
    },
    "theme_shop_price": {
      "type": "number",
      "description": "Base cost in tokens to unlock a premium theme",
      "default": 30
    },
    "theme_discount_percent": {
      "type": "number",
      "description": "Discount percentage applied to the theme shop price (0-100)",
      "default": 0
    },
    "theme_offer_active": {
      "type": "boolean",
      "description": "Whether the limited-time discount offer is active for users",
      "default": false
    },
    "theme_offer_end_time": {
      "type": "string",
      "description": "ISO datetime when the limited-time theme offer expires"
    },
    "filterInactiveFromLeaderboard": {
      "type": "boolean",
      "description": "When true, the Vault Titans leaderboard auto-filters users with no app activity in the last 30 days",
      "default": false
    },
    "blackjack_difficulty": {
      "type": "string",
      "enum": [
        "very_easy",
        "easy",
        "normal",
        "hard"
      ],
      "description": "Blackjack 21 difficulty. Controls Player 2 (AI) hit/stand strategy, the Dealer stand threshold, and whether the AI competes for the pot. Payout stays identical (2\u00d7 win, 2.5\u00d7 natural Blackjack) on every level. very_easy = AI is dealt for display only and is EXCLUDED from settlement (you compete against the Dealer only), Dealer stands on all 15+; easy = AI stands on 13+, Dealer stands on all 15+ (3-way winner-takes-all); normal = AI hits below 17, Dealer stands on all 17; hard = AI plays to beat the player's visible hand, Dealer hits soft 17.",
      "default": "normal"
    },
    "monthly_conversion_cap": {
      "type": "number",
      "description": "Admin-set ceiling on the tokens a single player may convert into casino chips per Brunei calendar month. Drives the Cashier's Monthly Limit pill and blocks further purchases once reached. Falls back to 1000000 when unset.",
      "default": 1000000
    },
    "daily_cashout_cap": {
      "type": "number",
      "description": "Admin-set ceiling on the chips a single player may cash back into tokens per Brunei day. Drives the Cashier's Daily Limit pill and blocks further cash-outs once reached. Falls back to 5000 when unset.",
      "default": 5000
    }
  },
  "required": []
}