{
  "name": "DailyChallenge",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner of this daily challenge record."
    },
    "user_name": {
      "type": "string",
      "description": "Display name of the player."
    },
    "day": {
      "type": "string",
      "format": "date",
      "description": "Brunei-calendar day key (YYYY-MM-DD) this record is for. A new day creates a new record, so challenges reset at Brunei midnight."
    },
    "missions": {
      "type": "array",
      "description": "Three generated daily missions. Each: { slot, type, target, reward, label, claimed, claimedAt }. Progress is derived from `counters` by `type`, not stored per-mission.",
      "items": {
        "type": "object"
      }
    },
    "counters": {
      "type": "object",
      "description": "Live Ranked-only counters for today: { hands, wins, blackjacks, currentStreak, maxStreak }. Updated only by Ranked hand settlement.",
      "properties": {
        "hands": {
          "type": "number"
        },
        "wins": {
          "type": "number"
        },
        "blackjacks": {
          "type": "number"
        },
        "currentStreak": {
          "type": "number"
        },
        "maxStreak": {
          "type": "number"
        }
      }
    },
    "daily_mystery_card_status": {
      "type": "string",
      "enum": [
        "unopened",
        "revealed"
      ],
      "default": "unopened",
      "description": "Whether today's Daily Mystery Card has been revealed. unopened = the first-launch modal should prompt the player; revealed = the card was chosen today and the modal must not reappear this Brunei day."
    },
    "daily_mystery_card_selection": {
      "type": "number",
      "description": "The card index (0, 1 or 2) the player chose today. -1 before a choice is made.",
      "default": -1
    },
    "daily_mystery_card_reward": {
      "type": "string",
      "enum": [
        "surge_2x",
        "chips_100",
        "bet_cap_25"
      ],
      "description": "The reward revealed on today's Daily Mystery Card: surge_2x = 30-min 2\u00d7 Rank Surge, bet_cap_25 = 20-min 25-chip Ranked bet cap, chips_100 = 100 chips credited directly plus 100 seasonal \ud83c\udfc6RANK points."
    },
    "bonus_mystery_card_status": {
      "type": "string",
      "enum": [
        "locked",
        "revealed"
      ],
      "default": "locked",
      "description": "The BONUS Mystery Card for this day. It is claimable only once every daily mission has been claimed, and is never opened automatically \u2014 the player taps the bonus button. locked = not yet revealed; revealed = the bonus card was chosen today and cannot be rerolled or re-credited."
    },
    "bonus_mystery_card_selection": {
      "type": "number",
      "description": "The bonus card index (0, 1 or 2) the player chose today. -1 before a choice is made.",
      "default": -1
    },
    "bonus_mystery_card_reward": {
      "type": "string",
      "enum": [
        "surge_2x",
        "chips_100",
        "bet_cap_25"
      ],
      "description": "The reward revealed on today's BONUS Mystery Card: surge_2x = 30-min 2\u00d7 Rank Surge, bet_cap_25 = 20-min 25-chip Ranked bet cap, chips_100 = 100 chips credited directly plus 100 seasonal \ud83c\udfc6RANK points."
    },
    "rank_surge_expires_at": {
      "type": "number",
      "default": 0,
      "description": "UNIX epoch ms when the active 30-minute 2\u00d7 Rank Surge buff expires. 0 = no active boost. While active, Ranked winning payouts count double toward the seasonal \ud83c\udfc6RANK score."
    },
    "rank_bet_cap_expires_at": {
      "type": "number",
      "default": 0,
      "description": "UNIX epoch ms when the active 20-minute High Roller Pass (25-chip Ranked bet cap) expires. 0 = no active cap. While active, the Ranked table's wager ceiling is raised from 10 to 25 chips."
    },
    "last_mystery_popup_date": {
      "type": "string",
      "description": "Brunei day key (YYYY-MM-DD) of the last Daily Mystery Card reveal. Set when the card is revealed so the modal does not pop up again that day on refresh or relaunch."
    }
  },
  "required": [
    "user_id",
    "day"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}