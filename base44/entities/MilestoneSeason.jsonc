{
  "name": "MilestoneSeason",
  "type": "object",
  "properties": {
    "season_number": {
      "type": "number",
      "default": 1,
      "description": "Current milestone season number. Increments when a new season starts (monthly rollover on the 1st, or an admin force start). It is the key per-player progress rows are compared against, so every player's score and streak reset lazily the next time they load."
    },
    "season_month": {
      "type": "string",
      "description": "The Asia/Brunei calendar month this season belongs to, as YYYY-MM. It defines the season's window: the off-season countdown targets 00:00 Brunei on the 1st of the month AFTER this one."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "ended",
        "completed"
      ],
      "default": "active",
      "description": "active = season in progress and Ranked is open; ended = the season is over and Ranked is locked until the next Brunei month (or an admin force start); completed = legacy value from before monthly seasons, treated exactly like ended."
    },
    "diamond_claimed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the Rank 10 Diamond grand prize has been claimed this season. First-claim-wins \u2014 only one player can ever claim it per season."
    },
    "diamond_claimed_by": {
      "type": "string",
      "description": "User ID of the first player to claim the Rank 10 Diamond this season."
    },
    "diamond_claimed_by_name": {
      "type": "string",
      "description": "Display name of the Diamond claimant."
    },
    "diamond_claimed_at": {
      "type": "number",
      "default": 0,
      "description": "UNIX epoch ms when the Diamond was claimed."
    },
    "season_winner_id": {
      "type": "string",
      "description": "User ID of the season champion shown on the off-season card. Set to the Diamond claimant when the season ends on a Rank 10 claim, or to the points leader when an admin ends it manually."
    },
    "season_winner_name": {
      "type": "string",
      "description": "Display name of the season champion."
    },
    "ended_by": {
      "type": "string",
      "enum": [
        "diamond",
        "admin"
      ],
      "description": "How the season ended: diamond = a player claimed the Rank 10 Diamond; admin = an admin forced the season to end. Empty while the season is still active."
    },
    "ended_at": {
      "type": "number",
      "default": 0,
      "description": "UNIX epoch ms when the season ended. 0 while the season is still active."
    },
    "last_reset_at": {
      "type": "number",
      "default": 0,
      "description": "UNIX epoch ms of the last new-season start."
    }
  },
  "required": [
    "season_number",
    "status"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {},
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}