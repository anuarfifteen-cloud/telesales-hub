{
  "name": "BeatMyHandChallenge",
  "type": "object",
  "properties": {
    "creator_id": {
      "type": "string",
      "description": "User ID of Player 1 \u2014 the player who posted the hand. Their stake is deducted the moment the challenge is posted."
    },
    "creator_name": {
      "type": "string",
      "description": "Display name of Player 1, kept so the board reads without a lookup."
    },
    "format": {
      "type": "string",
      "enum": [
        "standard",
        "best_of_3"
      ],
      "enumColors": [
        "gray",
        "purple"
      ],
      "default": "standard",
      "description": "How many hands the match is played over. standard = one hand each, played simultaneously (blind play) and compared exactly as before. best_of_3 = three hands each, compared by index; the most hand wins takes the pot. Records created before Best of 3 existed have no value here and are always treated as standard."
    },
    "creator_score": {
      "type": "number",
      "description": "Player 1's final hand total, written when Player 1 stands or busts. Values above 21 are a bust. On a Best of 3 match this is Player 1's first hand; the full set lives in creator_hands."
    },
    "creator_cards": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "The exact cards Player 1 drew, in order ({ suit, color, rank, value }), written when Player 1 stands or busts. On a Best of 3 match these are Player 1's first hand; the full set lives in creator_hands."
    },
    "creator_submitted_at": {
      "type": "number",
      "default": 0,
      "description": "UNIX epoch ms when Player 1 finished their standard-format hand. 0 means Player 1 has not finished yet \u2014 the two sides write only their own score fields, so the two submissions can never overwrite each other."
    },
    "creator_hands": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Best of 3 only: Player 1's three finished hands in order, each { score, cards }. Empty on a standard match, whose single hand stays in creator_score and creator_cards."
    },
    "opponent_id": {
      "type": "string",
      "description": "User ID of Player 2 \u2014 the player who accepted the challenge. Empty while it is still open."
    },
    "opponent_name": {
      "type": "string",
      "description": "Display name of Player 2."
    },
    "opponent_score": {
      "type": "number",
      "description": "Player 2's final hand total, written when Player 2 stands or busts. On a Best of 3 match this is Player 2's first hand."
    },
    "opponent_cards": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "The exact cards Player 2 finished on, kept for the showdown reveal and the settled record. On a Best of 3 match these are their first hand."
    },
    "opponent_submitted_at": {
      "type": "number",
      "default": 0,
      "description": "UNIX epoch ms when Player 2 finished their standard-format hand. 0 means Player 2 has not finished yet."
    },
    "opponent_hands": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Best of 3 only: Player 2's three finished hands in order, each { score, cards }, written when they settle the match."
    },
    "hand_results": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Best of 3 only: who took each indexed hand, in order \u2014 'creator', 'opponent' or 'tie'. A hand is a tie when both bust or both finish on the same valid total. Drives the sequential showdown scoreboard."
    },
    "creator_hand_wins": {
      "type": "number",
      "default": 0,
      "description": "Best of 3 only: number of indexed hands Player 1 won."
    },
    "opponent_hand_wins": {
      "type": "number",
      "default": 0,
      "description": "Best of 3 only: number of indexed hands Player 2 won. The higher of the two takes the pot; equal counts are a push and refund both stakes."
    },
    "wager": {
      "type": "number",
      "description": "The stake each side put up, in the currency named by stake_type: a chip count, or 1 for the Diamond tier. Staked once per match \u2014 a Best of 3 is still a single stake per player. The pot is twice this amount, in the same currency."
    },
    "stake_type": {
      "type": "string",
      "enum": [
        "chips",
        "diamond"
      ],
      "enumColors": [
        "yellow",
        "blue"
      ],
      "default": "chips",
      "description": "Which wallet the stake moves in. chips = the wager is a chip amount paid from casinoChips; diamond = the wager is 1 Diamond paid from diamonds. Diamonds are never converted to chips: the payouts below are in the same currency as the stake. Records created before the Diamond tier existed have no value here and are treated as chips."
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "settled",
        "expired"
      ],
      "enumColors": [
        "blue",
        "green",
        "gray"
      ],
      "default": "open",
      "description": "open = live (accepting a challenger, or being played by both sides); settled = both hands are in and the pot was decided; expired = the acceptance window passed with no taker, or the match was voided after the opponent failed to finish \u2014 both stakes returned."
    },
    "outcome": {
      "type": "string",
      "enum": [
        "creator_win",
        "opponent_win",
        "push",
        "house",
        "expired",
        "void"
      ],
      "enumColors": [
        "blue",
        "green",
        "yellow",
        "red",
        "gray",
        "gray"
      ],
      "description": "Who won the pot. creator_win = Player 1 took it; opponent_win = Player 2 took it; push = tied valid hands and both stakes returned; house = both busted and the pot is burned; expired = no taker inside the 90-second window; void = the opponent never finished their hand in time and both stakes are returned. On a Best of 3 match this is decided by total hand wins, and equal hand wins are always a push."
    },
    "creator_payout": {
      "type": "number",
      "default": 0,
      "description": "What is owed to Player 1 by this challenge (the pot for a win, their stake back for a push, expiry or void), in the challenge's stake currency. Collected by Player 1 on their own device, which is the only way a client can credit that wallet."
    },
    "opponent_payout": {
      "type": "number",
      "default": 0,
      "description": "What is owed to Player 2 by this challenge, in the challenge's stake currency. Credited by the accepting device at settlement."
    },
    "creator_claimed": {
      "type": "boolean",
      "default": false,
      "description": "Whether Player 1 has collected their payout. Prevents paying the same result twice."
    },
    "opponent_claimed": {
      "type": "boolean",
      "default": false,
      "description": "Whether Player 2 has collected (or was directly credited) their payout."
    },
    "expires_at": {
      "type": "number",
      "description": "UNIX epoch ms when the 90-second acceptance window closes. Swept lazily whenever any player loads the board, and only for challenges no challenger has taken."
    },
    "settle_deadline": {
      "type": "number",
      "default": 0,
      "description": "UNIX epoch ms by which the second player must finish. Set when the first standard-format hand is submitted; when it passes with one hand still missing, the match is voided and both stakes are returned. 0 on a match where nobody has finished yet."
    },
    "settled_at": {
      "type": "string",
      "description": "ISO timestamp the challenge was settled, expired or voided."
    }
  },
  "required": [
    "creator_id",
    "creator_score",
    "wager",
    "status"
  ],
  "rls": {
    "read": {},
    "create": {
      "data.creator_id": "{{user.id}}"
    },
    "update": {},
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}