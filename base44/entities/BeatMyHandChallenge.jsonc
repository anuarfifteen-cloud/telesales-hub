{
  "name": "BeatMyHandChallenge",
  "type": "object",
  "properties": {
    "creator_id": {
      "type": "string",
      "description": "User ID of Player 1 \u2014 the player who posted the hand. Their stake is deducted when the challenge is posted."
    },
    "creator_name": {
      "type": "string",
      "description": "Display name of Player 1, kept so the board reads without a lookup."
    },
    "creator_score": {
      "type": "number",
      "description": "Player 1's final hand total. Values above 21 are a bust. Hidden from Player 2 on the board until they finish their own hand."
    },
    "creator_cards": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "The exact cards Player 1 drew, in order ({ suit, color, rank, value }). Stored so the challenger's showdown can deal the poster's real hand out card by card instead of only showing the total."
    },
    "opponent_id": {
      "type": "string",
      "description": "User ID of Player 2 \u2014 the player who accepted the challenge. Empty while it is still open."
    },
    "opponent_name": {
      "type": "string",
      "description": "Display name of Player 2."
    },
    "opponent_score": {
      "type": "number",
      "description": "Player 2's final hand total, written when they settle the challenge."
    },
    "opponent_cards": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "The exact cards Player 2 finished on, kept for the showdown reveal and the settled record."
    },
    "wager": {
      "type": "number",
      "description": "The stake each side put up, in the currency named by stake_type: a chip count, or 1 for the Diamond tier. The pot is twice this amount, in the same currency."
    },
    "stake_type": {
      "type": "string",
      "enum": [
        "chips",
        "diamond"
      ],
      "enumColors": [
        "yellow",
        "blue"
      ],
      "default": "chips",
      "description": "Which wallet the stake moves in. chips = the wager is a chip amount paid from casinoChips; diamond = the wager is 1 Diamond paid from diamonds. Diamonds are never converted to chips: the payouts below are in the same currency as the stake. Records created before the Diamond tier existed have no value here and are treated as chips."
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "settled",
        "expired"
      ],
      "enumColors": [
        "blue",
        "green",
        "gray"
      ],
      "default": "open",
      "description": "open = accepting players; settled = Player 2 finished their hand and the pot was decided; expired = nobody accepted within 90 seconds and Player 1's stake is returned."
    },
    "outcome": {
      "type": "string",
      "enum": [
        "creator_win",
        "opponent_win",
        "push",
        "house",
        "expired"
      ],
      "enumColors": [
        "blue",
        "green",
        "yellow",
        "red",
        "gray"
      ],
      "description": "Who won the pot. creator_win = Player 1 took it; opponent_win = Player 2 took it; push = tied valid hands and both stakes returned; house = both busted and the pot is burned; expired = no taker inside the 90-second window."
    },
    "creator_payout": {
      "type": "number",
      "default": 0,
      "description": "What is owed to Player 1 by this challenge (the pot for a win, their stake back for a push or expiry), in the challenge's stake currency. Collected by Player 1 on their own device, which is the only way a client can credit that wallet."
    },
    "opponent_payout": {
      "type": "number",
      "default": 0,
      "description": "What is owed to Player 2 by this challenge, in the challenge's stake currency. Credited by the accepting device at settlement."
    },
    "creator_claimed": {
      "type": "boolean",
      "default": false,
      "description": "Whether Player 1 has collected their payout. Prevents paying the same result twice."
    },
    "opponent_claimed": {
      "type": "boolean",
      "default": false,
      "description": "Whether Player 2 has collected (or was directly credited) their payout."
    },
    "expires_at": {
      "type": "number",
      "description": "UNIX epoch ms when the 90-second acceptance window closes. Swept lazily whenever any player loads the board."
    },
    "settled_at": {
      "type": "string",
      "description": "ISO timestamp the challenge was settled or expired."
    }
  },
  "required": [
    "creator_id",
    "creator_score",
    "wager",
    "status"
  ],
  "rls": {
    "read": {},
    "create": {
      "data.creator_id": "{{user.id}}"
    },
    "update": {},
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}