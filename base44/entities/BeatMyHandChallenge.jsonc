{
  "name": "BeatMyHandChallenge",
  "type": "object",
  "properties": {
    "creator_id": {
      "type": "string",
      "description": "User ID of Player 1 \u2014 the player who posted the hand. Their stake is deducted when the challenge is posted (public challenges) or when the opponent accepts (targeted rematches)."
    },
    "creator_name": {
      "type": "string",
      "description": "Display name of Player 1, kept so the board reads without a lookup."
    },
    "creator_score": {
      "type": "number",
      "description": "Player 1's final hand total. Values above 21 are a bust. Hidden from Player 2 on the board until they finish their own hand."
    },
    "creator_cards": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "The exact cards Player 1 drew, in order ({ suit, color, rank, value }). Stored so the challenger's showdown can deal the poster's real hand out card by card instead of only showing the total."
    },
    "opponent_id": {
      "type": "string",
      "description": "User ID of Player 2 \u2014 the player who accepted the challenge. Empty while it is still open."
    },
    "opponent_name": {
      "type": "string",
      "description": "Display name of Player 2."
    },
    "opponent_score": {
      "type": "number",
      "description": "Player 2's final hand total, written when they settle the challenge."
    },
    "opponent_cards": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "The exact cards Player 2 finished on, kept for the showdown reveal and the settled record."
    },
    "wager": {
      "type": "number",
      "description": "Chips each side staked. The pot is twice this amount."
    },
    "rematch": {
      "type": "boolean",
      "default": false,
      "description": "True when this record is a private targeted rematch from the previous showdown instead of a public board challenge. Targeted rematches never appear on the public board and are only shown to target_id."
    },
    "target_id": {
      "type": "string",
      "description": "User ID of the only player who may see and accept a targeted rematch \u2014 the previous opponent. Empty for public challenges."
    },
    "target_name": {
      "type": "string",
      "description": "Display name of the targeted opponent, kept so the rematch card reads without a lookup."
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "accepted",
        "settled",
        "expired",
        "cancelled"
      ],
      "enumColors": [
        "blue",
        "purple",
        "green",
        "gray",
        "red"
      ],
      "default": "open",
      "description": "open = awaiting an acceptance (public board, or the 5-second private rematch window); accepted = the opponent paid and is playing a targeted rematch; settled = Player 2 finished their hand and the pot was decided; expired = a public challenge was not taken within 90 seconds and Player 1's stake is returned; cancelled = a targeted rematch was not accepted within 5 seconds, or was cancelled for insufficient chips \u2014 nothing was staked."
    },
    "outcome": {
      "type": "string",
      "enum": [
        "creator_win",
        "opponent_win",
        "push",
        "house",
        "expired",
        "cancelled"
      ],
      "enumColors": [
        "blue",
        "green",
        "yellow",
        "red",
        "gray",
        "gray"
      ],
      "description": "Who won the pot. creator_win = Player 1 took it; opponent_win = Player 2 took it; push = tied valid hands and both stakes returned; house = both busted and the pot is burned; expired = no taker inside the window; cancelled = a private rematch was withdrawn before anyone was charged."
    },
    "creator_payout": {
      "type": "number",
      "default": 0,
      "description": "Chips owed to Player 1 by this challenge (the pot for a win, their stake back for a push or expiry). Collected by Player 1 on their own device, which is the only way a client can credit that wallet."
    },
    "opponent_payout": {
      "type": "number",
      "default": 0,
      "description": "Chips owed to Player 2 by this challenge. Credited immediately by the accepting device at settlement."
    },
    "creator_claimed": {
      "type": "boolean",
      "default": false,
      "description": "Whether Player 1 has collected their payout. Prevents paying the same result twice."
    },
    "opponent_claimed": {
      "type": "boolean",
      "default": false,
      "description": "Whether Player 2 has collected (or was directly credited) their payout."
    },
    "expires_at": {
      "type": "number",
      "description": "UNIX epoch ms when the acceptance window closes \u2014 90 seconds for a public challenge, 5 seconds for a targeted rematch. Swept lazily whenever any player loads the board."
    },
    "accepted_at": {
      "type": "number",
      "default": 0,
      "description": "UNIX epoch ms when the targeted opponent accepted this rematch and both stakes were settled in."
    },
    "settled_at": {
      "type": "string",
      "description": "ISO timestamp the challenge was settled, expired or cancelled."
    }
  },
  "required": [
    "creator_id",
    "creator_score",
    "wager",
    "status"
  ],
  "rls": {
    "read": {},
    "create": {
      "data.creator_id": "{{user.id}}"
    },
    "update": {},
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}