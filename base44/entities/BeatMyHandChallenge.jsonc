{
  "name": "BeatMyHandChallenge",
  "type": "object",
  "properties": {
    "creator_id": {
      "type": "string",
      "description": "User ID of Player 1 \u2014 the player who posted the hand. Their stake is deducted when the challenge is posted."
    },
    "creator_name": {
      "type": "string",
      "description": "Display name of Player 1, kept so the board reads without a lookup."
    },
    "format": {
      "type": "string",
      "enum": [
        "standard",
        "best_of_3"
      ],
      "enumColors": [
        "gray",
        "purple"
      ],
      "default": "standard",
      "description": "How many hands the match is played over. standard = one hand each, compared exactly as before. best_of_3 = three hands each, compared by index; the most hand wins takes the pot. Records created before Best of 3 existed have no value here and are always treated as standard."
    },
    "creator_score": {
      "type": "number",
      "description": "Player 1's final hand total. Values above 21 are a bust. On a Best of 3 match this is Player 1's first hand; the full set lives in creator_hands."
    },
    "creator_cards": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "The exact cards Player 1 drew, in order ({ suit, color, rank, value }). On a Best of 3 match these are Player 1's first hand; the full set lives in creator_hands."
    },
    "creator_hands": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Best of 3 only: Player 1's three finished hands in order, each { score, cards }. Empty on a standard match, whose single hand stays in creator_score and creator_cards."
    },
    "opponent_id": {
      "type": "string",
      "description": "User ID of Player 2 \u2014 the player who accepted the challenge. Empty while it is still open."
    },
    "opponent_name": {
      "type": "string",
      "description": "Display name of Player 2."
    },
    "opponent_score": {
      "type": "number",
      "description": "Player 2's final hand total, written when they settle the challenge. On a Best of 3 match this is Player 2's first hand."
    },
    "opponent_cards": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "The exact cards Player 2 finished on, kept for the showdown reveal and the settled record. On a Best of 3 match these are their first hand."
    },
    "opponent_hands": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Best of 3 only: Player 2's three finished hands in order, each { score, cards }, written when they settle the match."
    },
    "hand_results": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Best of 3 only: who took each indexed hand, in order \u2014 'creator', 'opponent' or 'tie'. A hand is a tie when both bust or both finish on the same valid total. Drives the sequential showdown scoreboard."
    },
    "creator_hand_wins": {
      "type": "number",
      "default": 0,
      "description": "Best of 3 only: number of indexed hands Player 1 won."
    },
    "opponent_hand_wins": {
      "type": "number",
      "default": 0,
      "description": "Best of 3 only: number of indexed hands Player 2 won. The higher of the two takes the pot; equal counts are a push and refund both stakes."
    },
    "wager": {
      "type": "number",
      "description": "The stake each side put up, in the currency named by stake_type: a chip count, or 1 for the Diamond tier. Staked once per match \u2014 a Best of 3 is still a single stake per player. The pot is twice this amount, in the same currency."
    },
    "stake_type": {
      "type": "string",
      "enum": [
        "chips",
        "diamond"
      ],
      "enumColors": [
        "yellow",
        "blue"
      ],
      "default": "chips",
      "description": "Which wallet the stake moves in. chips = the wager is a chip amount paid from casinoChips; diamond = the wager is 1 Diamond paid from diamonds. Diamonds are never converted to chips: the payouts below are in the same currency as the stake. Records created before the Diamond tier existed have no value here and are treated as chips."
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "settled",
        "expired"
      ],
      "enumColors": [
        "blue",
        "green",
        "gray"
      ],
      "default": "open",
      "description": "open = accepting players; settled = Player 2 finished their hand and the pot was decided; expired = nobody accepted within 90 seconds and Player 1's stake is returned."
    },
    "outcome": {
      "type": "string",
      "enum": [
        "creator_win",
        "opponent_win",
        "push",
        "house",
        "expired"
      ],
      "enumColors": [
        "blue",
        "green",
        "yellow",
        "red",
        "gray"
      ],
      "description": "Who won the pot. creator_win = Player 1 took it; opponent_win = Player 2 took it; push = tied valid hands and both stakes returned; house = both busted and the pot is burned; expired = no taker inside the 90-second window. On a Best of 3 match this is decided by total hand wins, and equal hand wins are always a push."
    },
    "creator_payout": {
      "type": "number",
      "default": 0,
      "description": "What is owed to Player 1 by this challenge (the pot for a win, their stake back for a push or expiry), in the challenge's stake currency. Collected by Player 1 on their own device, which is the only way a client can credit that wallet."
    },
    "opponent_payout": {
      "type": "number",
      "default": 0,
      "description": "What is owed to Player 2 by this challenge, in the challenge's stake currency. Credited by the accepting device at settlement."
    },
    "opponent_stake_taken": {
      "type": "boolean",
      "default": false,
      "description": "Whether the accepting device has already deducted Player 2's matching stake from their wallet. Written only after that wallet write succeeds, so a retried or resumed settlement can never charge the same wager twice."
    },
    "creator_claimed": {
      "type": "boolean",
      "default": false,
      "description": "Whether Player 1 has collected their payout. Prevents paying the same result twice."
    },
    "opponent_claimed": {
      "type": "boolean",
      "default": false,
      "description": "Whether Player 2 has collected (or was directly credited) their payout."
    },
    "expires_at": {
      "type": "number",
      "description": "UNIX epoch ms when the 90-second acceptance window closes. Swept lazily whenever any player loads the board."
    },
    "settled_at": {
      "type": "string",
      "description": "ISO timestamp the challenge was settled or expired."
    }
  },
  "required": [
    "creator_id",
    "creator_score",
    "wager",
    "status"
  ],
  "rls": {
    "read": {},
    "create": {
      "data.creator_id": "{{user.id}}"
    },
    "update": {},
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}