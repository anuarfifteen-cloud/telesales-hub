{
  "name": "TableAction",
  "type": "object",
  "properties": {
    "table_id": {
      "type": "string",
      "description": "ActiveTable row id this action targets"
    },
    "round_id": {
      "type": "string",
      "description": "Round id at submission time. The host ignores actions whose round_id does not match the table's current round, so a stale action from a previous round can never apply to the next one. HEARTBEAT actions ignore round_id (presence applies across rounds)."
    },
    "user_id": {
      "type": "string",
      "description": "User submitting the action"
    },
    "user_name": {
      "type": "string",
      "description": "Display name of the submitting user"
    },
    "seat_id": {
      "type": "number",
      "description": "Seat the action applies to"
    },
    "action_type": {
      "type": "string",
      "enum": [
        "JOIN",
        "LEAVE",
        "ACCEPT_BET",
        "DECLINE_BET",
        "HIT",
        "STAND",
        "CLAIM",
        "HEARTBEAT",
        "BLITZ_SCORE"
      ],
      "description": "JOIN = claim an open seat; LEAVE = leave a seat (used for entry-fee rollback in Blitz); ACCEPT_BET = pay the 100-chip Blitz entry fee (chips already deducted by the submitter); DECLINE_BET = decline and leave; HIT/STAND = legacy PvP actions (unused in Blitz, where hands are local); CLAIM = the player credited their own wallet for a settled payout and the host should mark the seat claimed and add them to paid_winner_ids; HEARTBEAT = presence ping; BLITZ_SCORE = submit the player's current temporary Blitz Chip balance (the score value is in the wager field), so the host can update the seat's blitz_score for the live leaderboard and winner determination."
    },
    "wager": {
      "type": "number",
      "default": 0,
      "description": "For ACCEPT_BET: the 100-chip entry fee the submitter already deducted from their wallet (the host copies it onto the seat's bet_chips). For BLITZ_SCORE: the player's current temporary Blitz Chip balance (the host copies it onto the seat's blitz_score). The host never deducts or credits chips \u2014 only the player's own client does."
    }
  },
  "required": [
    "table_id",
    "round_id",
    "user_id",
    "seat_id",
    "action_type"
  ],
  "rls": {
    "read": {},
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {},
    "delete": {}
  }
}