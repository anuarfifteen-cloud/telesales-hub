{
  "name": "Voucher",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID of the user who owns this voucher"
    },
    "user_name": {
      "type": "string",
      "description": "Display name of the user"
    },
    "code": {
      "type": "string",
      "description": "Unique voucher code e.g. BV-XXXX-XXXX"
    },
    "reward_type": {
      "type": "string",
      "enum": [
        "tokens",
        "chips",
        "diamond"
      ],
      "description": "Which currency this voucher pays out when redeemed. Vouchers created before this field existed fall back to 'tokens', or 'diamond' when reward_tokens is the 999 sentinel."
    },
    "reward_amount": {
      "type": "number",
      "description": "Amount of reward_type paid out \u2014 tokens or Blackjack 21 chips. Diamond vouchers always pay 1."
    },
    "reward_tokens": {
      "type": "number",
      "description": "Legacy token amount, kept for older records and admin displays. Tokens = the token amount (1-5), diamond = the 999 sentinel, chips = 0 (chips are not tokens)."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "redeemed"
      ],
      "default": "active",
      "description": "active = not yet redeemed, redeemed = used"
    },
    "created_at": {
      "type": "string",
      "description": "ISO timestamp of when the voucher was created"
    }
  },
  "required": [
    "user_id",
    "code",
    "status"
  ]
}