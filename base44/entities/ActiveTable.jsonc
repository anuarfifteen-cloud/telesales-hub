{
  "name": "ActiveTable",
  "type": "object",
  "properties": {
    "round_id": {
      "type": "string",
      "description": "Human-readable identifier for the current round, e.g. RND-84920. Regenerated for every new round and for every emergency reset."
    },
    "status": {
      "type": "string",
      "enum": [
        "waiting_for_bets",
        "player_turns",
        "settling",
        "completed",
        "resetting"
      ],
      "default": "waiting_for_bets",
      "description": "Phase of the shared PvP round. waiting_for_bets = seats place equal wagers; player_turns = all players act simultaneously (Hit/Stand/Ready) until everyone is ready or the reveal deadline passes; settling = host evaluates the pot and flags payouts; completed = payouts flagged, players choose Replay/New Bet/Stop; resetting = emergency reset in progress."
    },
    "current_turn_seat": {
      "type": "number",
      "default": 1,
      "description": "Legacy field retained for compatibility. Simultaneous-play mode does not use turn order; every dealt-in player acts at once."
    },
    "host_user_id": {
      "type": "string",
      "description": "User ID of the client currently holding the host lease (running the table engine). The holder renews host_lease_expires_at each tick; when the lease expires any eligible active player claims it, so processing continues even if the previous host closed their tab."
    },
    "host_lease_expires_at": {
      "type": "number",
      "default": 0,
      "description": "UNIX epoch ms when the current host's lease expires. The active host renews this to now + LEASE_MS every tick. When now exceeds this value the host is considered gone and the lowest-numbered seated player (excluding the dead host if others remain) claims the lease."
    },
    "last_action_timestamp": {
      "type": "number",
      "description": "UNIX epoch ms of the last table activity. Drives the 30-second emergency reset window and the completed-round auto-advance."
    },
    "betting_ends_at": {
      "type": "number",
      "description": "UNIX epoch ms when the betting phase closes. 0 means betting has not opened yet (no wager placed)."
    },
    "deal_at": {
      "type": "number",
      "description": "UNIX epoch ms when the host deals after the betting window closes. Adds a short grace window for auto-bets. 0 means not scheduled."
    },
    "reveal_deadline": {
      "type": "number",
      "default": 0,
      "description": "UNIX epoch ms when the 30-second simultaneous-play reveal window ends. Set when the host deals. When it passes, any not-yet-ready dealt-in hand is auto-readied (stood + ready) and the pot is scored. 0 means not in play."
    },
    "replay_deadline": {
      "type": "number",
      "default": 0,
      "description": "UNIX epoch ms when the Play Again accept/decline window closes. Set by the host when initiating a replay. When it passes, any non-responding seated player is treated as declined. 0 means no replay is pending."
    },
    "next_action": {
      "type": "string",
      "enum": [
        "replay",
        "replay_pending",
        "new_bet",
        "stop"
      ],
      "description": "The next-round choice a player makes once a round completes. replay_pending = host initiated Play Again and is waiting for other seated players to accept or decline before the round proceeds."
    },
    "common_wager": {
      "type": "number",
      "default": 0,
      "description": "The equal chip wager every participant must contribute to the pot. Set by the first bettor; subsequent bettors must match it. 0 means no wager has been placed yet."
    },
    "total_pot": {
      "type": "number",
      "default": 0,
      "description": "Accumulated chip pool for the round \u2014 the sum of all participating wagers. Awarded to the winning hand(s) or refunded on an all-bust."
    },
    "deck": {
      "type": "array",
      "description": "Remaining shuffled cards for this round, drawn by player hits. Refilled on every new round. There is no Dealer hand in PvP mode.",
      "items": {
        "type": "object"
      }
    },
    "min_bet": {
      "type": "number",
      "default": 1,
      "description": "Minimum chip wager per hand"
    },
    "max_bet": {
      "type": "number",
      "default": 50,
      "description": "Maximum chip wager per hand"
    },
    "seats": {
      "type": "array",
      "description": "Up to 5 seat objects holding each player's wager, cards, hand value, readiness, phase status and self-payout flags.",
      "items": {
        "type": "object",
        "properties": {
          "seat_id": {
            "type": "number"
          },
          "user_id": {
            "type": "string"
          },
          "user_name": {
            "type": "string"
          },
          "bet_chips": {
            "type": "number"
          },
          "cards": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "hand_value": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "empty",
              "betting",
              "playing",
              "stood",
              "busted",
              "disconnected"
            ]
          },
          "ready": {
            "type": "boolean",
            "default": false,
            "description": "True once the player has pressed Ready (or been auto-readied by the reveal deadline). A busted hand counts as ready regardless. The pot is scored only when every dealt-in player is ready."
          },
          "auto_replay": {
            "type": "boolean",
            "default": false,
            "description": "Set true at the start of a Replay round: the seat's bet_chips is pre-filled with the common wager but not yet paid. The player's own client re-deducts and flips this to false to commit."
          },
          "last_activity": {
            "type": "number",
            "description": "UNIX epoch ms of the seat's last gameplay interaction (join, bet, hit). Drives the 60s betting idle-kick for uncommitted bettors."
          },
          "last_seen": {
            "type": "number",
            "description": "UNIX epoch ms of the seat's last presence heartbeat, updated by the host when it processes a HEARTBEAT action. Drives the presence-based kick: a seat whose last_seen is stale beyond PRESENCE_TIMEOUT_MS is treated as disconnected and freed so new players can join."
          },
          "payout_flag": {
            "type": "string",
            "enum": [
              "PENDING",
              "WINNER",
              "SPLIT",
              "REFUND",
              "LOSS"
            ]
          },
          "payout_amount": {
            "type": "number",
            "description": "Exact chip amount this seat receives at settlement. WINNER = whole pot; SPLIT = pot share (lowest tied seat gets any remainder); REFUND = original wager; LOSS = 0."
          },
          "payout_claimed": {
            "type": "boolean"
          },
          "replay_accept": {
            "type": "boolean",
            "default": null,
            "description": "A non-host seated player's response to the host's Play Again prompt. true = accepts the same-wager rematch; false = declines and sits the round out; null = has not responded yet."
          }
        }
      }
    }
  },
  "required": [
    "status",
    "round_id"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {},
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}