{
  "name": "ActiveTable",
  "type": "object",
  "properties": {
    "round_id": {
      "type": "string",
      "description": "Human-readable identifier for the current round, e.g. RND-84920. Regenerated for every new round and for every emergency reset."
    },
    "status": {
      "type": "string",
      "enum": [
        "waiting_for_bets",
        "player_turns",
        "settling",
        "completed",
        "resetting"
      ],
      "default": "waiting_for_bets",
      "description": "Phase of the shared PvP round. waiting_for_bets = seats place equal wagers during the 10s window; player_turns = seats act in order (Hit/Stand); settling = host evaluates the pot and flags payouts; completed = payouts flagged; resetting = emergency reset in progress."
    },
    "current_turn_seat": {
      "type": "number",
      "default": 1,
      "description": "Seat number (1-5) whose turn it is. Only that seat's client may act; every other client's Hit/Stand controls are disabled."
    },
    "host_user_id": {
      "type": "string",
      "description": "User ID of the client running the table engine (dealing, timeout auto-stand, pot evaluation, payouts). Hands off to the lowest remaining seat when the host leaves."
    },
    "last_action_timestamp": {
      "type": "number",
      "description": "UNIX epoch ms of the last table activity. Drives the 10-second per-turn timer and the 30-second emergency reset window."
    },
    "betting_ends_at": {
      "type": "number",
      "description": "UNIX epoch ms when the 10-second betting phase closes. 0 means betting has not opened yet (no wager placed)."
    },
    "deal_at": {
      "type": "number",
      "description": "UNIX epoch ms when the host deals after the betting window closes. Adds a short grace window for auto-bets. 0 means not scheduled."
    },
    "common_wager": {
      "type": "number",
      "default": 0,
      "description": "The equal chip wager every participant must contribute to the pot. Set by the first bettor; subsequent bettors must match it. 0 means no wager has been placed yet."
    },
    "total_pot": {
      "type": "number",
      "default": 0,
      "description": "Accumulated chip pool for the round \u2014 the sum of all participating wagers. Awarded to the winning hand(s) or refunded on an all-bust."
    },
    "deck": {
      "type": "array",
      "description": "Remaining shuffled cards for this round, drawn by player hits. Refilled on every new round. There is no Dealer hand in PvP mode.",
      "items": {
        "type": "object"
      }
    },
    "min_bet": {
      "type": "number",
      "default": 1,
      "description": "Minimum chip wager per hand"
    },
    "max_bet": {
      "type": "number",
      "default": 50,
      "description": "Maximum chip wager per hand"
    },
    "seats": {
      "type": "array",
      "description": "Up to 5 seat objects holding each player's wager, cards, hand value, phase status and self-payout flags.",
      "items": {
        "type": "object",
        "properties": {
          "seat_id": {
            "type": "number"
          },
          "user_id": {
            "type": "string"
          },
          "user_name": {
            "type": "string"
          },
          "bet_chips": {
            "type": "number"
          },
          "cards": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "hand_value": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "empty",
              "betting",
              "playing",
              "stood",
              "busted",
              "disconnected"
            ]
          },
          "payout_flag": {
            "type": "string",
            "enum": [
              "PENDING",
              "WINNER",
              "SPLIT",
              "REFUND",
              "LOSS"
            ]
          },
          "payout_amount": {
            "type": "number",
            "description": "Exact chip amount this seat receives at settlement. WINNER = whole pot; SPLIT = pot share (lowest tied seat gets any remainder); REFUND = original wager; LOSS = 0."
          },
          "payout_claimed": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "required": [
    "status",
    "round_id"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {},
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}