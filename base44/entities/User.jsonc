{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "earlyAccessTokens": {
      "type": "number",
      "default": 0,
      "description": "Number of early access tokens the user has"
    },
    "casinoChips": {
      "type": "number",
      "default": 0,
      "description": "Blackjack 21 chips \u2014 a secondary currency used exclusively for Blackjack 21 betting. Purchased with tokens via the Chip Cashier; wins pay back in chips. Chips can be cashed out to tokens in the Cashier with a 20% service fee."
    },
    "avatar_photo_url": {
      "type": "string",
      "description": "Public URL of the user's uploaded profile photo (shown on profile & leaderboards)"
    },
    "avatar_initials": {
      "type": "string",
      "description": "Up to 2 custom letters shown inside the avatar when no photo is set"
    },
    "last_spin_date": {
      "type": "string",
      "description": "Date of last daily spin (YYYY-MM-DD, Brunei timezone)"
    },
    "last_chip_gift_date": {
      "type": "string",
      "description": "Date the daily free 5-chip Blackjack 21 gift was claimed (YYYY-MM-DD, Brunei timezone). One claim per user per Brunei day, shared across devices; the gift popup is skipped for the rest of the day once set."
    },
    "is_defending_champ": {
      "type": "boolean",
      "default": false,
      "description": "Whether this user is the defending Super Tap champion, placed on a one-season prize cooldown"
    },
    "is_defending_champ_flappy": {
      "type": "boolean",
      "default": false,
      "description": "Whether this user is the defending Flappy Token champion, placed on a one-season prize cooldown"
    },
    "is_defending_champ_diamond": {
      "type": "boolean",
      "default": false,
      "description": "Whether this user is the defending Diamond Smash champion, placed on a one-season prize cooldown"
    },
    "is_defending_champ_ninja": {
      "type": "boolean",
      "default": false,
      "description": "Whether this user is the defending Ninja Slice champion, placed on a one-season prize cooldown"
    },
    "diamonds": {
      "type": "number",
      "default": 0,
      "description": "Number of diamonds the user has purchased"
    },
    "last_diamond_purchase_date": {
      "type": "string",
      "description": "ISO timestamp of the user's last diamond purchase, used for the 30-day cooldown"
    },
    "active_pass_expiry": {
      "type": "string",
      "description": "ISO timestamp of when the user's 7-Day Priority Access pass expires"
    },
    "tapVaultBalance": {
      "type": "number",
      "default": 0,
      "description": "TAP Savings Vault balance \u2014 80% of monthly wealth tax is deposited here"
    },
    "lastTaxDate": {
      "type": "string",
      "description": "YYYY-MM of the last month this user was taxed by the Monthly Progressive Tax"
    },
    "lastVaultActionDate": {
      "type": "string",
      "description": "YYYY-MM of the last month the user took a TAP Vault action (withdraw or re-invest)"
    },
    "hideFromLeaderboard": {
      "type": "boolean",
      "default": false,
      "description": "When true, this user is excluded from the public Vault Titans leaderboard (set by admin)"
    },
    "lastActiveDate": {
      "type": "string",
      "description": "YYYY-MM-DD (Brunei timezone) of the user's most recent app session, updated client-side on app load for inactive-user leaderboard filtering"
    },
    "diamondSmashBoosters": {
      "type": "object",
      "description": "Persistent stock of Diamond Smash boosters purchased by the user",
      "properties": {
        "time_freeze": {
          "type": "number",
          "default": 0
        },
        "end_game": {
          "type": "number",
          "default": 0
        },
        "move_boost": {
          "type": "number",
          "default": 0
        }
      },
      "default": {
        "time_freeze": 0,
        "end_game": 0,
        "move_boost": 0
      }
    },
    "monthlyVoucherData": {
      "type": "object",
      "description": "Tracks how many tokens the user has gifted into vouchers this Brunei-calendar month (50/month cap)",
      "properties": {
        "month": {
          "type": "string",
          "description": "YYYY-MM of the tracked month (Brunei timezone)"
        },
        "amount": {
          "type": "number",
          "default": 0,
          "description": "Tokens gifted into vouchers during the tracked month"
        }
      },
      "default": {
        "month": "",
        "amount": 0
      }
    }
  },
  "rls": {
    "read": {}
  }
}