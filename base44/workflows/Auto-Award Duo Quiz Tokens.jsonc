{
  "name": "Auto-Award Duo Quiz Tokens",
  "description": "",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"p1_score\") != null) or (.trigger.changed_fields | index(\"p2_score\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "FiveDayScore"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_award_duo_quiz_tokens",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "duoAutoReward",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "duoAutoReward"
  }
}